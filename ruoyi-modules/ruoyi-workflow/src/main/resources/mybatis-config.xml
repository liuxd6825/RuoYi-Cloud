<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD MyBatis 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <!-- 配置 MyBatis 的全局设置 -->
    <settings>
        <setting name="cacheEnabled" value="true"/> <!-- 启用二级缓存 -->
        <setting name="lazyLoadingEnabled" value="true"/> <!-- 延迟加载 -->
        <setting name="logImpl" value="SLF4J"/> <!-- 日志实现，支持 SLF4J、Log4J 等 -->
        <setting name="jdbcTypeForNull" value="NULL"/> <!-- NULL 类型的处理 -->
    </settings>

    <!-- 配置 MyBatis 的类型别名 -->
    <typeAliases>
        <typeAlias type="com.ruoyi.workflow.domain.TaskView" alias="TaskView"/>
    </typeAliases>

    <!-- 配置插件 -->
    <plugins>
        <!-- 配置 PageHelper 插件 -->
        <plugin interceptor="com.github.pagehelper.PageInterceptor">
            <property name="dialect" value="mysql"/> <!-- 数据库方言 -->
            <property name="reasonable" value="true"/> <!-- 合理化分页 -->
            <property name="supportMethodsArguments" value="true"/> <!-- 支持方法参数传递分页 -->
        </plugin>
    </plugins>

</configuration>